async function replaysForUsername(playerName,offset,count) {
    var xmlhttp = new XMLHttpRequest();
    var url = `${serverPrefix}api/replaysForUsername?u=${playerName}&offset=${offset}&count=${count}`; console.log('calling url:',url);
    return new Promise((resolve, reject) => {
        xmlhttp.open("GET", url, true);
        xmlhttp.onreadystatechange = function() {
            if(this.readyState != 4) return;
            if (this.status == 200) {
                resolve(JSON.parse(this.responseText));
            } else {
                reject();
            }
        };
        xmlhttp.send();
    }).then(async x=>{
        return x.map(tuple=>[tuple.id,new Date(tuple.started)]);
    });
}

const CONST_USERNAME_MAX_LEN = 19;//in case of special chars? aส็็็็็็็็็็็็็็็็ "a%E0%B8%AA%E0%B9%87%E0%B9%87%E0%B9%87%E0%B9%87%E0%B9%87%E0%B9%87%E0%B9%87%E0%B9%87%E0%B9%87%E0%B9%87%E0%B9%87%E0%B9%87%E0%B9%87%E0%B9%87%E0%B9%87%E0%B9%87"
function getReplay(replayId, started) {
	return new Promise((resolve, reject) => {
		var xmlhttp = new XMLHttpRequest();
		xmlhttp.open("GET", amazonPrefix + replayId + ".gior", true);
		xmlhttp.onreadystatechange = function() {
			if (this.readyState == 4) {
				if (this.status == 200) {
					try {
						var gior = JSON.parse(LZString.decompressFromUint8Array(new Uint8Array(this.response)));
						let usernames = gior[4];
						let chat = gior[17];
                        if (chat.length===0) {resolve([]);}

                        //hack alignment
						let CONST_LAST_MESSAGE_TURN = chat[chat.length-1][3];
						let CONST_LAST_MESSAGE_TURN_LEN = CONST_LAST_MESSAGE_TURN.toString().length;
						let CONST_LONGEST_CHAT_NAME = Math.max(...chat.map(tuple => usernames[tuple[2]].length));
						CONST_LONGEST_CHAT_NAME = Math.min(CONST_USERNAME_MAX_LEN, CONST_LONGEST_CHAT_NAME);
                        let parsechat = chat.map(tuple =>
                                    [usernames[tuple[2]].padEnd(CONST_LONGEST_CHAT_NAME,' '),
									tuple[3].toString().padEnd(CONST_LAST_MESSAGE_TURN_LEN,' '),
									tuple[0], tuple[1]]);
						resolve(parsechat);
					} catch (e) {
						reject(e);
					}
				} else {
					reject("Failed to fetch replay: status " + this.status);
				}
			}
		};
		xmlhttp.responseType = "arraybuffer";
		xmlhttp.send();
	});
}

let OFFSET = 0; const CONST_CHUNK_SIZE = 200;
const WAIT_N_SECONDS_TO_FETCH_GIOR = 0.02; const WAIT_N_SECONDS_TO_FETCH_200_REPLAYS = 0.02;
