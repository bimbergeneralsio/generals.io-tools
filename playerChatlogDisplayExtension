while (replayId_started.length!==0) {//plan to parse all of player's replays
    replayId_started = await replaysForUsername(username,OFFSET,CONST_CHUNK_SIZE);
    for(let i = 0; i < replayId_started.length; i++){
        let replayId = replayId_started[i][0]; let started = replayId_started[i][1];
        let resultStr = await getReplay(replayId,started).then(async parsechat => {
            let node = document.createElement("a");
            node.setAttribute("href",`${serverPrefix}replays/`+replayId);
            node.setAttribute("target","_blank");
            let appendToInnerHTML = '';
            let usernameSentAnyMessage = false; let anyoneSentAnyMessage = parsechat.length>0;
            for (let onemessage of parsechat) {
                if (onemessage[0].slice(0,username.length)===username) {
                    appendToInnerHTML += `<span style="color: yellow">`;
                    usernameSentAnyMessage = true;
                }
                else {
                    appendToInnerHTML += `<span style="color: white">`;
                }
                appendToInnerHTML += '\t'+onemessage+`\n</span>`;
            }
            if (anyoneSentAnyMessage)
                node.innerHTML += (usernameSentAnyMessage?`<span style="color: yellow">`:`<span style="color: white">`) + '\n'+replayId+' '+started+' game#'+(OFFSET+i+1)+`\n</span>` + appendToInnerHTML;
            node.style.fontWeight = "normal";
            ChatLog.appendChild(node);
        })
        .catch(err => {
            console.error(err);
        });
        await new Promise(resolve => setTimeout(resolve, WAIT_N_SECONDS_TO_FETCH_GIOR*1000)); //sleep for .gior fetch API (every 1 replay)
    }
    OFFSET+=CONST_CHUNK_SIZE;
    await new Promise(resolve => setTimeout(resolve, WAIT_N_SECONDS_TO_FETCH_200_REPLAYS*1000)); //sleep for replaysForUsername API (every 200 replays)
}
